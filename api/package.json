{
  "name": "certification-flashcards-api",
  "private": true,
  "version": "0.1.0",
  "description": "Server-authoritative multiplayer challenge API",
  "main": "dist/api/src/functions/*.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copyDecks.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint src test",
    "start": "npm run build && func start",
    "start:test": "npm run build && NODE_ENV=test node dist/api/src/testServer.js",
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.0",
    "@azure/functions": "^4.7.2",
    "@azure/identity": "^4.13.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
